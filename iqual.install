  $styles_to_remove = array_values(array_unique(array_filter(
    array_map(static fn ($style) => trim((string) $style), $styles_to_remove),
    static fn ($style) => $style !== ''
  )));

  $result = _iqual_update_style_templates_and_delete_unreferenced_styles($styles_to_remove);

  return t('Updated @templates image style templates. Deleted @deleted styles and kept @kept due to custom Twig references.', [
    '@templates' => $result['updated_templates'],
    '@deleted' => $result['deleted_count'],
    '@kept' => $result['kept_count'],
  ]);
}

/**
 * Update style templates and delete non-referenced image styles.
 */
function _iqual_update_style_templates_and_delete_unreferenced_styles(array $styles_to_remove): array {
  $styles_to_remove = array_values(array_unique(array_filter(
    array_map(static fn ($style) => trim((string) $style), $styles_to_remove),
    static fn ($style) => $style !== ''
  )));

  if (empty($styles_to_remove)) {
    return [
      'updated_templates' => 0,
      'deleted_count' => 0,
      'kept_count' => 0,
    ];
  }

  $usage_map = _iqual_find_style_usages($styles_to_remove, ['modules/custom', 'themes/custom']);
  $used_styles = array_keys(array_filter($usage_map, static fn ($matches) => !empty($matches)));
  $styles_to_delete = array_values(array_diff($styles_to_remove, $used_styles));

  // Specific to pagedesigner_responsive_images module: Remove references to the styles in image style templates.
  $updated_templates = 0;
  if (\Drupal::moduleHandler()->moduleExists('pagedesigner_responsive_images')) {

    $template_storage = \Drupal::entityTypeManager()->getStorage('image_style_template');
    $templates = $template_storage->loadMultiple();
   

    foreach ($templates as $template) {
      /** @var \Drupal\pagedesigner_responsive_images\Entity\ImageStyleTemplate $template */
      $settings = (string) ($template->get('settings') ?? '');
      if ($settings === '') {
        continue;
      }

      $updated_settings = _remove_style_lines($settings, $styles_to_remove);
      if ($updated_settings !== $settings) {
        $template->set('settings', $updated_settings);
        $template->save();
        $updated_templates++;
      }
    }
  }

  $storage = \Drupal::entityTypeManager()->getStorage('image_style');
  $styles = $storage->loadMultiple($styles_to_delete);
  $deleted_count = count($styles);
  if (!empty($styles)) {
    $storage->delete($styles);
  }

  $logger = \Drupal::logger('iqual');
  foreach ($used_styles as $style) {
    $logger->warning('Image style "@style" was not deleted because it is referenced in custom Twig: @files', [
      '@style' => $style,
      '@files' => implode(', ', $usage_map[$style]),
    ]);
  }

  return [
    'updated_templates' => $updated_templates,
    'deleted_count' => $deleted_count,
    'kept_count' => count($used_styles),
  ];
}

/**
 * Find image style name usages in custom modules/themes Twig files.
 */
function _iqual_find_style_usages(array $style_names, array $relative_dirs): array {
  $style_names = array_values(array_unique(array_filter(
    array_map(static fn ($style) => trim((string) $style), $style_names),
    static fn ($style) => $style !== ''
  )));

  $usage_map = array_fill_keys($style_names, []);
  if (empty($style_names)) {
    return $usage_map;
  }

  $excluded_root = rtrim(DRUPAL_ROOT, '/') . '/modules/custom/iqual_custom/';

  foreach ($relative_dirs as $relative_dir) {
    $scan_root = DRUPAL_ROOT . '/' . ltrim($relative_dir, '/');
    if (!is_dir($scan_root)) {
      continue;
    }

    $iterator = new \RecursiveIteratorIterator(
      new \RecursiveDirectoryIterator($scan_root, \FilesystemIterator::SKIP_DOTS)
    );

    /** @var \SplFileInfo $file_info */
    foreach ($iterator as $file_info) {
      if (!$file_info->isFile()) {
        continue;
      }

      $path_name = $file_info->getPathname();
      if (str_starts_with($path_name, $excluded_root)) {
        continue;
      }

      $ext = strtolower($file_info->getExtension());
      if ($ext !== 'twig') {
        continue;
      }

      $contents = @file_get_contents($path_name);
      if ($contents === FALSE || $contents === '') {
        continue;
      }

      $relative_path = ltrim(str_replace(DRUPAL_ROOT, '', $path_name), '/');
      foreach ($style_names as $style_name) {
        if (str_contains($contents, $style_name)) {
          $usage_map[$style_name][] = $relative_path;
        }
      }
    }
  }

  foreach ($usage_map as $style_name => $paths) {
    $usage_map[$style_name] = array_values(array_unique($paths));
  }

  return $usage_map;
}

/**
 * Update media image field settings for max filesize and resolution.
 */
function iqual_update_10009() {
  $config = \Drupal::configFactory()->getEditable('field.field.media.image.field_media_image');
  if ($config->isNew()) {
    return t('Media image field configuration not found.');
  }

  $updated = [];

  // Update max_filesize to 10 MB.
  if ($config->get('settings.max_filesize') !== '10 MB') {
    $config->set('settings.max_filesize', '10 MB');
    $updated[] = 'max_filesize';
  }

  // Update max_resolution to 3840x2160 (4K).
  if ($config->get('settings.max_resolution') !== '3840x2160') {
    $config->set('settings.max_resolution', '3840x2160');
    $updated[] = 'max_resolution';
  }

  if (!empty($updated)) {
    $config->save();
    return t('Updated media image field settings: @settings.', [
      '@settings' => implode(', ', $updated),
    ]);
  }

  return t('Media image field settings already up to date.');
}
